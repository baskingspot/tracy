.{
    .name = .tracy,
    .version = "0.1.0",
    .fingerprint = 0x255a89ee0aa0d01a, // Changing this has security and trust implications.
    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // The test runner. Lazy: only the root build uses it, and build.zig
        // returns early for a consumer.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.6.0.tar.gz",
            .hash = "testingx-0.6.0-ib95-yaGAwC1_nvSTOk8ktbCgVfBtDAVTCjNKgXRxBeo",
            .lazy = true,
        },
    },
    // The files a release tarball carries, the vendored C client included, so
    // a build needs no fetch beyond the test runner.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
        "LICENSE",
        "LICENSE-ZIG",
        "README.md",
        "THIRD_PARTY.md",
    },
}
